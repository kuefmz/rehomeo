PORT=4321
# Enable only after operator/privacy review and authorised delivery test.
PUBLIC_QUOTE_ENABLED=false
QUOTE_ENABLED=false
# Verified Websiteli endpoint; server-only. Confirm Rehomeo routing before enabling.
