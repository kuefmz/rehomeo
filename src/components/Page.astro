---
import { getCollection } from "astro:content";
import { site, path, type Locale, type PageKey } from "../data/routes";
import CTA from "./CTA.astro";
import QuoteForm from "./QuoteForm.astro";
const { lang, pageKey } = Astro.props as { lang: Locale; pageKey: PageKey };
const c = site[lang];
const articles = (await getCollection("articles"))
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => a.data.translationKey.localeCompare(b.data.translationKey));
const text = (
  {
    how: c.how,
    clearance: c.clearance,
    pickup: c.pickup,
    reuse: c.env,
    coverage: c.coverage,
    faq: c.ctaSub,
    contact: c.ctaSub,
    blog: c.footer,
    privacy: c.legal,
    business: c.legal,
  } as Record<string, string>
)[pageKey];
const legalDetails = {
  en: [
    "Operator name, legal form and postal address: not yet verified.",
    "Verified contact email and telephone: required before launch.",
    "Data controller, processors, hosting locations and international transfers: to be confirmed.",
    "Enquiry retention, deletion, access rights and a privacy contact: to be confirmed.",
    "This build uses no analytics or tracking cookies. Form delivery remains disabled pending review.",
  ],
  de: [
    "Betreibername, Rechtsform und Postanschrift: noch nicht verifiziert.",
    "Verifizierte E-Mail-Adresse und Telefonnummer: vor dem Start erforderlich.",
    "Verantwortlicher, Auftragsverarbeiter, Hostingstandorte und Auslandübermittlungen: zu bestätigen.",
    "Aufbewahrung, Löschung, Auskunftsrechte und Datenschutzkontakt: zu bestätigen.",
    "Dieser Stand nutzt keine Analytics oder Tracking-Cookies. Die Formularzustellung bleibt bis zur Prüfung deaktiviert.",
  ],
  fr: [
    "Nom de l’exploitant, forme juridique et adresse postale : pas encore vérifiés.",
    "E-mail et téléphone vérifiés : nécessaires avant le lancement.",
    "Responsable des données, sous-traitants, hébergement et transferts internationaux : à confirmer.",
    "Conservation, suppression, droits d’accès et contact de confidentialité : à confirmer.",
    "Cette version n’utilise pas d’analytics ni de cookies de suivi. La livraison du formulaire reste désactivée avant vérification.",
  ],
  it: [
    "Nome dell’operatore, forma giuridica e indirizzo postale: non ancora verificati.",
    "E-mail e telefono verificati: necessari prima del lancio.",
    "Titolare, responsabili del trattamento, hosting e trasferimenti internazionali: da confermare.",
    "Conservazione, cancellazione, diritti di accesso e contatto privacy: da confermare.",
    "Questa versione non usa analytics o cookie di tracciamento. La consegna del modulo resta disattivata fino alla verifica.",
  ],
};
---

<section class="shell section page">
  <p class="eyebrow">
    REHOMEO ·{" "}
    {lang === "en"
      ? "SWITZERLAND"
      : lang === "de"
        ? "SCHWEIZ"
        : lang === "fr"
          ? "SUISSE"
          : "SVIZZERA"}
  </p>
  <h1>{c.names[pageKey]}</h1>
  <p class="lead">{text}</p>
  {pageKey === "how" && (
    <div class="cards">
      {c.steps.map((s, i) => (
        <div class="card">
          <span class="number">0{i + 1}</span>
          <h2>{s}</h2>
          <p>{c.stepText[i]}</p>
        </div>
      ))}
    </div>
  )}
  {["clearance", "pickup"].includes(pageKey) && (
    <div class="prose">
      <h2>{c.names.how}</h2>
      <p>{c.how}</p>
      <h2>{c.names.reuse}</h2>
      <p>{c.policy}</p>
      <p>{c.excluded}</p>
      <p>{c.cost}</p>
      <a href={path(lang, pageKey === "clearance" ? "pickup" : "clearance")}>
        {c.names[pageKey === "clearance" ? "pickup" : "clearance"]}
      </a>
    </div>
  )}
  {pageKey === "reuse" && (
    <div class="prose">
      <p>
        <a
          href={`https://www.bafu.admin.ch/${lang}/${{ de: "kreislaufwirtschaft", en: "circular-economy", fr: "economie-circulaire", it: "economia-circolare" }[lang]}`}
        >
          {c.sources}: BAFU / FOEN / OFEV / UFAM
        </a>
      </p>
      <h2>{c.values}</h2>
      <p>{c.valueText}</p>
      <p>{c.policy}</p>
      <table>
        <thead>
          <tr>
            <th>
              {lang === "de"
                ? "Weg"
                : lang === "fr"
                  ? "Parcours"
                  : lang === "it"
                    ? "Percorso"
                    : "Route"}
            </th>
            <th>
              {lang === "de"
                ? "Bedeutung"
                : lang === "fr"
                  ? "Sens"
                  : lang === "it"
                    ? "Significato"
                    : "Meaning"}
            </th>
          </tr>
        </thead>
        <tbody>
          {{
            en: [
              ["Reuse", "The item continues in use."],
              [
                "Donation",
                "Transfer without a sale; acceptance is not guaranteed.",
              ],
              [
                "Resale",
                "Transfer through a sale; disclose any agreed resale route.",
              ],
              ["Recycling", "Materials are processed for further use."],
              [
                "Disposal",
                "Waste handling when further use is unsuitable; agree the route.",
              ],
            ],
            de: [
              ["Wiederverwendung", "Der Gegenstand wird weiter genutzt."],
              ["Spende", "Weitergabe ohne Verkauf; Annahme nicht garantiert."],
              [
                "Weiterverkauf",
                "Weitergabe durch Verkauf; vereinbarten Weg offenlegen.",
              ],
              [
                "Recycling",
                "Materialien werden für weitere Nutzung verarbeitet.",
              ],
              [
                "Entsorgung",
                "Abfallbehandlung bei ungeeigneter Weiternutzung; Weg vereinbaren.",
              ],
            ],
            fr: [
              ["Réemploi", "L’objet continue à servir."],
              ["Don", "Transfert sans vente ; acceptation non garantie."],
              ["Revente", "Transfert par vente ; voie convenue à déclarer."],
              [
                "Recyclage",
                "Transformation des matières pour un nouvel usage.",
              ],
              [
                "Élimination",
                "Traitement des déchets inadaptés au réemploi ; voie à convenir.",
              ],
            ],
            it: [
              ["Riutilizzo", "L’oggetto continua a servire."],
              [
                "Donazione",
                "Trasferimento senza vendita; accettazione non garantita.",
              ],
              [
                "Rivendita",
                "Trasferimento mediante vendita; percorso da dichiarare.",
              ],
              ["Riciclaggio", "Materiali trasformati per un nuovo uso."],
              [
                "Smaltimento",
                "Gestione dei rifiuti non idonei al riutilizzo; percorso da concordare.",
              ],
            ],
          }[lang].map(([a, b]) => (
            <tr>
              <th scope="row">{a}</th>
              <td>{b}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>{c.cost}</p>
    </div>
  )}
  {pageKey === "coverage" && (
    <div class="prose">
      <h2>
        {lang === "de"
          ? "Schweiz"
          : lang === "fr"
            ? "Suisse"
            : lang === "it"
              ? "Svizzera"
              : "Switzerland"}
      </h2>
      <p>{c.note}</p>
      <h2>
        {lang === "de"
          ? "Deutschland"
          : lang === "fr"
            ? "Allemagne"
            : lang === "it"
              ? "Germania"
              : "Germany"}
      </h2>
      <p>{c.germany}</p>
    </div>
  )}
  {pageKey === "faq" && (
    <div class="faq">
      {c.faqPairs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  )}
  {pageKey === "contact" && <QuoteForm lang={lang} />}
  {pageKey === "blog" && (
    <div class="cards blog-cards">
      {articles.map((a) => (
        <a class="card" href={`${path(lang, "blog")}${a.data.slug}/`}>
          <p class="eyebrow">{c.names.blog}</p>
          <h2>{a.data.title}</h2>
          <p>{a.data.excerpt}</p>
          <span class="text-link">{c.read} ↗</span>
        </a>
      ))}
    </div>
  )}
  {["privacy", "business"].includes(pageKey) && (
    <div class="notice">
      <ul>
        {legalDetails[lang].map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </div>
  )}
</section>
{!["contact", "privacy", "business"].includes(pageKey) && <CTA lang={lang} />}
